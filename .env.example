# ==========================================
# The Lenny Growth Assistant — Configuration
# ==========================================

# ------------------------------------------
# 1. Model Provider Configuration
# ------------------------------------------
# Provider options: "ollama", "anthropic", "openai"
LLM_PROVIDER=ollama

# Local Ollama Settings (Default for local evaluation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Cloud LLM Settings (Optional - set if using cloud provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Request Timeout (seconds)
LLM_TIMEOUT_SECONDS=60

# ------------------------------------------
# 2. Database & Persistence Configuration
# ------------------------------------------
# Local PostgreSQL default or remote (Supabase / Railway)
DATABASE_URL=postgresql+asyncpg://devadarshinink@localhost:5432/lenny_assistant
# Sync URL for Alembic migrations if needed:
DATABASE_SYNC_URL=postgresql://devadarshinink@localhost:5432/lenny_assistant

# ------------------------------------------
# 3. Knowledge & Embedding Configuration
# ------------------------------------------
# Embedding provider: "local" (sentence-transformers) or "ollama"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35

# ------------------------------------------
# 4. Server & CORS Configuration
# ------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------
# 5. Environment & Logging
# ------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
